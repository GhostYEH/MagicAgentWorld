# AgentCraft 环境变量示例（复制为 .env 后填写）
# 说明：模拟模式无需任何密钥即可完整运行六章；真实模式需要填写以下变量。

# 服务端端口
PORT=8787

# 运行模式默认值：simulation | real
AGENTCRAFT_DEFAULT_MODE=simulation

# 真实模型适配器（OpenAI 兼容 Chat Completions 接口）
# 缺少 API Key 时，真实调用会被标记为“待验收”，模拟模式继续完整交付。
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=

# 真实模式下的单次请求超时（毫秒）
MODEL_REQUEST_TIMEOUT_MS=60000

# SQLite 运行记录存放目录（相对 apps/server）
AGENTCRAFT_DATA_DIR=./data
